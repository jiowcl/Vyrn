-- vyrn: 9
-- Module used by tests/vyrnc/vyrnc_app.vyrn (loaded from source, or as a compiled .vyrnc)
struct Pt
    x: number
    y: number
end

counter = 0

def bump(n: number = 1) -> number
    counter = counter + n
    return counter
end

def make_adder(k)
    def add(v)
        return v + k
    end
    return add
end

def make_pt(x, y)
    return Pt { x = x, y = y }
end

def norm2(p) -> number
    return p.x * p.x + p.y * p.y
end

def boom()
    error("mod boom", 0)
end

return { bump = bump, make_adder = make_adder, make_pt = make_pt, norm2 = norm2, boom = boom }
