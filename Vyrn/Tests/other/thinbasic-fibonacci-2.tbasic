' Fibonacci Sequence Test: Calculate the 35th term (Fibonacci 35).

Uses "Console"

FUNCTION FibIter(BYVAL n AS LONG) AS LONG
  DIM a AS LONG, b AS LONG, i AS LONG, t AS LONG
  a = 0 : b = 1
  FOR i = 1 TO n
    t = a + b
    a = b
    b = t
  NEXT i
  FUNCTION = a
END FUNCTION

SUB RunBenchmark()
  DIM result AS LONG
  Dim T1, T2 As QUAD
  
  HiResTimer_Init
  
  T1 = HiResTimer_Get
  PRINTL "Start Fibonacci benchmark..."
  result = FibIter(35)
  PRINTL "Complete! Result: " & result   ' The correct answer should be 9227465
  T2 = HiResTimer_Get
  
  PRINTL "Time: " & FORMAT$(T2-T1, "#0")
END SUB

RunBenchmark()

Console_Read