' Fibonacci Sequence Test: Calculate the 35th term (Fibonacci 35).
function Fib(n)
    if n <= 1
        return n
    endif

    return Fib(n - 1) + Fib(n - 2)
endfunc

function RunBenchmark()
    pln "Start Fibonacci benchmark..."
    start = clock()
    result = Fib(35)
    elapsed = clock() - start 
    pln "Complete! Result: " + result ' The correct answer should be 9227465
    pln "Time taken: " + elapsed + " ms"
    pln "Time taken: " + (elapsed / 1000) + " seconds"
endfunc

RunBenchmark()

pln "Press enter to exit"
tmp = rln()