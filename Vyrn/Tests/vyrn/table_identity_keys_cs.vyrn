-- @compile-safe
-- vyrn: 12
-- 1.6.112: tables are valid table keys, compared by identity, on both runtimes
-- (get/set, pairs/next, rawget/rawset). A table used as a key stays alive while
-- its entry holds a value. nil keys raise "table index is nil"; boolean and
-- function keys are not supported in Vyrn (Lua allows them).
-- Expected output checked against Lua 5.4.

let a = {}
let b = {}
let t = {}
t[a] = "A"
t[b] = "B"
print(t[a], t[b], t[{}])
let n = 0
for k, v in pairs(t) do
    n = n + 1
end
print(n, rawequal(rawget(t, a), "A"), t[a] == t[b])
t[a] = nil
print(t[a], t[b])
rawset(t, a, 7)
print(rawget(t, a))
let c = {}
c[a] = 1
c[b] = 2
print(c[a] + c[b])
let c2 = {}
c2[a] = "x"
let k1, v1 = next(c2)
print(k1 == a, v1)

-- Many keys held elsewhere: values survive a collection.
let keys = {}
let m = {}
for i = 1, 2000 do
    let k = {i}
    keys[i] = k
    m[k] = i * 2
end
for i = 1, 3000 do
    let junk = {i, i}
end
collectgarbage()
let sum = 0
for i = 1, 2000 do
    sum = sum + m[keys[i]]
end
print(sum)
let cnt, ksum = 0, 0
for k, v in pairs(m) do
    cnt = cnt + 1
    ksum = ksum + k[1]
end
print(cnt, ksum)

-- Keys reachable only through the table are kept alive.
let m2 = {}
for i = 1, 500 do
    m2[{i}] = i
end
for i = 1, 3000 do
    let junk = {i}
end
collectgarbage()
let s2 = 0
for k, v in pairs(m2) do
    s2 = s2 + k[1] + v
end
print(s2)

-- Removed keys: no stale entries, and fresh tables never match old ids.
let t3 = {}
let holder = {}
for i = 1, 50 do
    let x = {}
    t3[x] = i
    holder[i] = x
end
for i = 1, 50 do
    t3[holder[i]] = nil
end
holder = nil
collectgarbage()
let hits = 0
for i = 1, 200 do
    let y = {}
    if t3[y] ~= nil then
        hits = hits + 1
    end
end
let left = 0
for k, v in pairs(t3) do
    left = left + 1
end
print(hits, left, next(t3))

-- Deleted string and number keys are not yielded by pairs either.
let d = {}
d["s"] = 1
d[0.5] = 2
d["s"] = nil
d[0.5] = nil
print(next(d))

let ok, err = pcall(def()
    let q = {}
    q[nil] = 1
end)
print(ok, string.find(err, "table index is nil", 1, true) ~= nil)
