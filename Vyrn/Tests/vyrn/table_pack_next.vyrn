let t = {10, 20, 30}
let p = table.pack(1, 2, 3)
print("pack-n", p.n)
print("pack1", p[1], p[2], p[3])
print("unpack-pack", table.unpack(p))

let k, v = next(t)
print("next1", k, v)
let k2, v2 = next(t, k)
print("next2", k2, v2)
let k3, v3 = next(t, k2)
print("next3", k3, v3)
print("next-end", next(t, k3))
