-- @compile-safe
-- vyrn: 12 unlimited
-- closure_gc (1.6.93): unreachable closures and upvalue cells are reclaimed; reachable
-- ones (tables, globals, upvalues, coroutines) survive collectgarbage(). Prints booleans only.
-- rep(n, fn): calls fn(i) for i = 1..n via gsub, from a host callback (gsub) frame.
-- Chunks of 1000 keep the gsub strings small, so "count" deltas track closures.
def rep(n, fn)
  let i = 0
  let chunk = string.rep("x", 1000)
  while i < n do
    string.gsub(chunk, "x", function() if i < n then i = i + 1 fn(i) end end)
  end
end
def mk(i)
  return function() return i end
end
def counter()
  let n = 0
  return function() n = n + 1 return n end
end
def outer(x)
  def middle()
    return function() x = x + 1 return x end
  end
  return middle()
end
