collectgarbage()
let c0 = collectgarbage("count")
-- 1: 200k churn, nothing kept
let s = 0
rep(200000, function(i)
  let f = mk(i)
  s = s + f()
end)
let lastf = nil
for i = 1, 20000 do
  let x = i
  lastf = function() return x end
end
collectgarbage()
let c1 = collectgarbage("count")
print("churn", s == 20000100000, lastf() == 20000, c1 - c0 < 512)
-- 2: survivors in tables, globals, upvalues and coroutines
keepT = {}
for i = 1, 100 do keepT[i] = counter() end
gkeep = counter()
let up = counter()
def useUp() return up() end
let co = coroutine.create(function()
  let v = 7
  let f = function() v = v + 1 return v end
  coroutine.yield(f)
  return v
end)
let ok1, cf = coroutine.resume(co)
let co2 = coroutine.create(function()
  let v = 1
  let g = function() v = v * 3 return v end
  g()
  g = nil
  coroutine.yield(0)
  v = v + 1
  return v
end)
coroutine.resume(co2)
rep(30000, function(i) let f = counter() f() end)
collectgarbage()
collectgarbage()
print("survive", keepT[1]() == 1, keepT[100]() == 1, keepT[100]() == 2, gkeep() == 1, useUp() == 1)
print("co", ok1, cf() == 8, cf() == 9)
let ok2, rv = coroutine.resume(co)
let ok3, rv3 = coroutine.resume(co2)
print("co2", ok2, rv == 9, ok3, rv3 == 4)
-- 3: self-referential / recursive closures and pass-through chains
let fsum = 0
rep(20000, function(i)
  let fact = nil
  fact = function(n) if n <= 1 then return 1 end return n * fact(n - 1) end
  fsum = fsum + fact(5)
  let p = outer(i)
  fsum = fsum + p() - i
end)
let keepP = outer(100)
let selfT = {}
selfT.f = function() return selfT end
collectgarbage()
let c3 = collectgarbage("count")
print("rec", fsum == 20000 * 121, keepP() == 101, keepP() == 102, selfT.f() == selfT, c3 - c0 < 512)
-- 4: dropped suspended coroutines
let alive = nil
for i = 1, 3000 do
  let c = coroutine.create(function()
    let z = i
    let h = function() z = z + 1 return z end
    coroutine.yield(h)
    return z
  end)
  let okc, h = coroutine.resume(c)
  if i == 1500 then alive = { c, h } end
end
collectgarbage()
let hv = alive[2]()
let okA, rA = coroutine.resume(alive[1])
print("dropco", hv == 1501, okA, rA == 1501, alive[2]() == 1502)
-- 5: wide-slot (v4) captures
let wsum = 0
for i = 1, 2000 do
  let wf = wide(i)
  wsum = wsum + wf()
end
let wk = wide(1)
collectgarbage()
print("wide", wsum == 2000 * (299 + 1 + 256) + 2001000, wk() == 557, wk() == 558)
