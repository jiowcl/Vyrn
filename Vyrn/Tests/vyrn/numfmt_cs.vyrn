-- @compile-safe
-- 1.6.67: number formatting parity with PB StrD (exact %.10f, half-even,
-- trailing zeros stripped, +/-Infinity), <table>/<func> display, tostring({...}),
-- and string.format %d/%f/%s/%% (1.6.113: full Lua 5.4 specs; %d rejects 3.9).

print(1, -1, 0, 0.5, 1.25, -2.75)
print(1 / 3, 2 / 3, -1 / 3)
print(1 / 2048, 3 / 2048, 5 / 2048, 7 / 2048)
print(0.1 + 0.2, 100 / 7)
print(math.pow(10, 15), math.pow(2, 53), math.pow(2, 53) + 1)
print(math.pow(10, 20), math.pow(2, 64))
print(1 / math.pow(10, 11), -1 / math.pow(10, 11), -0.0)
print(math.pow(10, -10), 5 * math.pow(10, -11), 15 * math.pow(10, -11))
print(math.huge, -math.huge)
print(string.len(tostring(math.huge)))
print(tostring(3.14159265358979), tostring(-0.000123))
print("c" .. 2.5 .. "|" .. 1 / 4 .. "|" .. 10)
print(string.format("%d|%i|%f|%s", 3, -3, 2.5, 1 / 8))
print(string.format("%g|%.2f|%x|100%%", 1, 2, 3))
print(string.format("%s %s", {}, print))
print(tostring({10, 20, 30}), tostring({}), tostring())
print(tostring({1.5, "a", true}))
let t = {}
print(t, print)
