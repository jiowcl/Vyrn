-- 1.6.79: repeat ... until gives closures fresh per-iteration locals
let fs = {}
let i = 0
repeat
  i += 1
  let j = i * 10
  fs[#fs + 1] = function() return j end
until j >= 30
print("repeat", #fs, fs[1](), fs[2](), fs[3]())
let gs = {}
let k = 0
repeat
  k += 1
  let m = k
  gs[#gs + 1] = function() m += 100 return m end
  if k == 2 then break end
until false
print("break", gs[1](), gs[2](), gs[1]())
let n = 0
repeat
  let done = n >= 2
  n += 1
until done
print("until-sees-local", n)
def collect()
  let out = {}
  let c = 0
  repeat
    c += 1
    let v = c
    out[c] = function() return v * v end
  until v == 4
  return out
end
let o = collect()
print("nested", o[1](), o[2](), o[3](), o[4]())
