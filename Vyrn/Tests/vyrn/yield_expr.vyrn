-- @compile-safe
-- 1.6.88: coroutine.yield() inside expressions / call args resumes into that expression.
-- Uses globals; closures capturing coroutine locals are covered by coroutine_upvalues.vyrn (1.6.89).
def cnt(...) return select("#", ...) end
let co = coroutine.create(function()
  print("a", cnt(coroutine.yield()))
  print("b", cnt(coroutine.yield(), 1))
  let x = coroutine.yield() + 1
  print("c", x)
  return coroutine.yield()
end)
print(coroutine.resume(co))
print(coroutine.resume(co, 1, 2))
print(coroutine.resume(co, 5, 6))
print(coroutine.resume(co, 10))
print(coroutine.resume(co, 7, 8))
print(coroutine.status(co))
o = {n = "o"}
o.m = function(self, ...) return self.n, select("#", ...), ... end
def inner(a)
  return a, cnt(coroutine.yield("in"))
end
let co2 = coroutine.create(function()
  let t = {coroutine.yield("t")}
  print("t", #t, t[1], t[2])
  let d = coroutine.yield("or") or "dflt"
  print("or", d)
  print("m", o:m(coroutine.yield("m")))
  print("nest", inner(9))
  print("zero", cnt(coroutine.yield("z")))
  print("first", cnt(coroutine.yield("f"), 1))
  coroutine.yield("stmt")
  print("after stmt")
  let ok, v = pcall(function() return cnt(coroutine.yield("p")) end)
  print("pcall", ok, v)
  return "done"
end)
print(coroutine.resume(co2))
print(coroutine.resume(co2, "A", "B"))
print(coroutine.resume(co2))
print(coroutine.resume(co2, 1, 2, 3))
print(coroutine.resume(co2, "x", "y"))
print(coroutine.resume(co2))
print(coroutine.resume(co2))
print(coroutine.resume(co2, 4))
print(coroutine.resume(co2))
print(coroutine.resume(co2, 5, 6))
let w = coroutine.wrap(function(a)
  let s = coroutine.yield(a + 1) + 10
  return s, cnt(coroutine.yield(s))
end)
print(w(1))
print(w(5))
print(w())
co3 = coroutine.create(function()
  coroutine.yield()
  let a, b = coroutine.yield(1)
  print("ab", a, b)
  let c = coroutine.yield()
  print("c", c)
  print("ret", select("#", coroutine.yield()))
  return coroutine.yield()
end)
print(coroutine.resume(co3))
print(coroutine.resume(co3, 9))
print(coroutine.resume(co3))
print(coroutine.resume(co3, 5, 6))
print(coroutine.resume(co3))
print(coroutine.resume(co3))
print(coroutine.resume(co3, 7, 8))
co4 = coroutine.create(function() return coroutine.yield() end)
coroutine.resume(co4)
print(coroutine.resume(co4, "r1", "r2"))
string.find("abc", "b")
coroutine.resume(co4)
let w2 = 5
print("w2", w2)
def h()
  let ok, v = pcall(function() return cnt(1, 2) end)
  print("pcall2", ok, v)
end
h()
