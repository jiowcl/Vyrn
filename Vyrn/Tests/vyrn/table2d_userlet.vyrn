-- @compile-safe
-- vyrn: 12 unlimited
-- table2d_userlet (1.6.110): only the loop hoist supplies a cached row base. A
-- user-written `let rb = (row - 1) * cols` is an ordinary local: table.get2d still
-- checks cols < 1 and uses the current row and cols even after they are reassigned.
let msg = def(ok, e)
    if ok then
        return "ok"
    end
    return string.match(e, "bad argument.*") or string.match(e, "attempt.*") or e
end
let t = {}
for i = 1, 12 do t[i] = i end
def g(row, col, cols)
    let rb = (row - 1) * cols
    return table.get2d(t, row, col, cols)
end
print("g", g(2, 1, 3))
print("g0", msg(pcall(g, 1, 2, 0)))
print("gneg", msg(pcall(g, 2, 1, -1)))
def h(row, col, cols)
    let rb = (row - 1) * cols
    row = row + 1
    return table.get2d(t, row, col, cols)
end
print("h", h(1, 1, 3))
def k(row, col, cols)
    let rb = (row - 1) * cols
    cols = 4
    return table.get2d(t, row, col, cols)
end
print("k", k(2, 1, 3))
def m(row, col, cols)
    let rb = (row - 1) * cols
    rb = 100
    return table.get2d(t, row, col, cols), rb
end
print("m", m(2, 1, 3))
