let t = {code = 42}
let ok, e = pcall(error, t)
print("tbl", ok, type(e), e == t, e.code)
let ok2, e2 = pcall(function() error({code = 7}) end)
print("tbl2", ok2, type(e2), e2.code)
let ok3, e3 = pcall(error, 12)
print("num", ok3, type(e3), e3)
let ok4, e4 = pcall(error, true)
print("bool", ok4, type(e4), e4)
let ok5, e5 = pcall(error)
print("nil", ok5, e5)
let ok6, e6 = pcall(function() error(5, 2) end)
print("num2", ok6, type(e6), e6)
print("xp", xpcall(error, function(m) return "h:" .. tostring(m) end, "msg"))
print("xp2", xpcall(error, function(m) return type(m) end, {}))
let ok7, e7 = xpcall(function() error({k = 1}) end, function(m) return m end)
print("xp3", ok7, type(e7), e7.k)
print("pc", pcall(error, "msg"))
print("pc2", pcall(error, "msg", 1))
let co = coroutine.create(function() error({c = 3}) end)
let cok, cerr = coroutine.resume(co)
print("co", cok, type(cerr))
let ok8, e8 = pcall(function() let x = nil; return x.y end)
print("rt", ok8, type(e8))
let ok9, e9 = pcall(function() error({n = 1}) end)
let ok10, e10 = pcall(function() let z = nil; return z.q end)
print("stale", type(e9), type(e10))
