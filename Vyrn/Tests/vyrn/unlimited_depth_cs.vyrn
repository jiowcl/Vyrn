-- @compile-safe
-- unlimited
-- 1.6.69: an "unlimited" header (or --unlimited) sets Vyrn_MaxCallDepth = 0 in
-- the PB VM, so recursion deeper than the default 256 frames succeeds; compiled
-- .vyrnc carries VYBC flag 0x1 and libvyrnrt lifts its frame cap the same way.
-- Depth stays far below PB's native stack ceiling (~12000 frames).

def ping(n)
    if n == 0 then
        return 0
    end
    return pong(n - 1) + 1
end
def pong(n)
    if n == 0 then
        return 0
    end
    return ping(n - 1) + 1
end
print(ping(300))
print(ping(1000))
def sum(n)
    if n == 0 then
        return 0
    end
    return n + sum(n - 1)
end
print(sum(2000))
let ok, r = pcall(sum, 1500)
print(ok, r)
def build(n, acc)
    if n == 0 then
        return acc
    end
    return build(n - 1, acc .. "x")
end
print(#build(800, ""))
