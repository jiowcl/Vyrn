-- vyrn: 8
print(string.match("key=value", "(%w+)=(%w+)"))
print(string.match("hello 123 world", "%d+"))
print(string.match("abc", "x"))
print(string.find("hello world", "o w"))
print(string.find("hello world", "(o)%s(w)"))
print(string.find("a.b", ".", 1, true))
print(string.find("abc", "", 2))
print(string.find("abc", "b", -2))
print(string.match("  trim me  ", "^%s*(.-)%s*$"))
print(string.match("[tag]", "%[(.-)%]"))
print(string.match("f(a(b)c)d", "%b()"))
print(string.match("THE (quick) fox", "%f[%a]%a+", 5))
print(string.match("hello", "()ll()"))
print(string.match("abab", "(ab)%1"))
print(string.gsub("hello world", "o", "0"))
print(string.gsub("hello world", "(%w+)", "<%1>"))
print(string.gsub("abc", "%w", "%0%0"))
print(string.gsub("hello world", "%w+", "X", 1))
print(string.gsub("abc", "", "-"))
print(string.gsub("$name is $age", "%$(%w+)", {name = "Ann", age = 7}))
print(string.gsub("a b c", "%a", def(c) return string.upper(c) end))
let words = {}
for w in string.gmatch("one two  three", "%a+") do words[#words + 1] = w end
print(#words, words[1], words[3])
let kv = {}
for k, v in string.gmatch("a=1, b=2", "(%w+)=(%w+)") do kv[#kv + 1] = {k, v} end
print(#kv, kv[1][1], kv[1][2], kv[2][1], kv[2][2])
print(string.match("2026-10-27", "(%d+)-(%d+)-(%d+)"))
print(string.find("x+y", "+", 1, true))
print(pcall(string.find, "abc", "[a"))
print(pcall(string.gsub, "abc", "b", "%2"))
print(pcall(string.match, "abc", "(a"))
print(pcall(string.gsub, "abc", "b", true))
print(pcall(string.gsub, "abc", "b", def(c) error("cb boom", 0) end))
print(string.gsub("abc", "b", def(c) return nil end))
print("done")
