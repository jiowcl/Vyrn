-- @compile-safe
-- coroutine_upvalues_gc: GC stress for closures that capture locals of
-- suspended / dead coroutines (open upvalues must be marked and stay valid).
keepS = {}
keepD = {}
live = {}
for i = 1, 40 do
  let co = coroutine.create(function()
    let v = i * 10
    let tag = "t" .. i
    keepS[i] = function() v = v + 1 return tag .. ":" .. v end
    coroutine.yield()
    v = v + 1000
    coroutine.yield()
  end)
  coroutine.resume(co)
  if i % 2 == 0 then live[#live + 1] = co end
end
for i = 1, 40 do
  let co = coroutine.create(function()
    let w = { n = i }
    keepD[i] = function() w.n = w.n + 1 return w.n end
    return 1
  end)
  coroutine.resume(co)
end
def churn(n)
  let t = {}
  for k = 1, n do t[k] = { k, "s" .. k } end
  return #t
end
print("g1", churn(800))
collectgarbage()
collectgarbage()
print("g2", keepS[1](), keepS[2](), keepS[39](), keepS[40]())
print("g3", keepD[1](), keepD[40](), keepD[40]())
for j = 1, #live do coroutine.resume(live[j]) end
print("g4", churn(800))
collectgarbage()
print("g5", keepS[1](), keepS[2](), keepS[39](), keepS[40]())
live = nil
collectgarbage()
print("g6", churn(500), keepS[2](), keepS[3](), keepD[2]())
let sum = 0
for i = 1, 40 do
  let s = keepS[i]()
  sum = sum + #s
end
print("g7", sum)
