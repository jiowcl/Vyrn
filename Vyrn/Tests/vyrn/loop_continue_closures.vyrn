-- per-iteration closures with continue/break (1.6.80)
def run(name, mk)
  let fs = mk()
  let out = {}
  for i = 1, #fs do out[#out + 1] = tostring(fs[i]()) end
  print(name, table.concat(out, " "))
end

run("repeat-cont", function()
  let fs = {}
  let i = 0
  repeat
    i = i + 1
    let v = i * 10
    fs[#fs + 1] = function() return v end
    if i == 1 then continue end
  until i >= 3
  return fs
end)

run("while-cont", function()
  let fs = {}
  let i = 0
  while i < 3 do
    i = i + 1
    let v = i * 10
    fs[#fs + 1] = function() return v end
    if i == 1 then continue end
  end
  return fs
end)

run("for-cont", function()
  let fs = {}
  for i = 1, 3 do
    let v = i * 10
    fs[#fs + 1] = function() return v end
    if i < 3 then continue end
  end
  return fs
end)

run("gfor-cont", function()
  let fs = {}
  for _, x in ipairs({1, 2, 3}) do
    let v = x * 10
    fs[#fs + 1] = function() return v end
    if x ~= 2 then continue end
  end
  return fs
end)

run("inner-block", function()
  let fs = {}
  for i = 1, 3 do
    if i > 0 then
      let w = i * 100
      fs[#fs + 1] = function() return w end
      if i < 3 then continue end
    end
  end
  return fs
end)

run("while-inner", function()
  let fs = {}
  let i = 0
  while i < 3 do
    i = i + 1
    if i ~= 99 then
      let w = i + 0.5
      fs[#fs + 1] = function() return w end
    end
  end
  return fs
end)

run("nested", function()
  let fs = {}
  for i = 1, 2 do
    let a = i
    let j = 0
    while j < 2 do
      j = j + 1
      let b = j
      fs[#fs + 1] = function() return a * 10 + b end
      if j == 1 then continue end
    end
    if i == 1 then continue end
  end
  return fs
end)

run("break-inner", function()
  let fs = {}
  let k = 0
  while true do
    k = k + 1
    let v = k
    fs[#fs + 1] = function() v = v + 1000 return v end
    if k == 2 then break end
  end
  fs[#fs + 1] = function() return k end
  return fs
end)

run("shared-outer", function()
  let fs = {}
  let acc = 0
  for i = 1, 3 do
    fs[#fs + 1] = function() acc = acc + i return acc end
    if i == 2 then continue end
  end
  return fs
end)

run("repeat-inner-only", function()
  let fs = {}
  let i = 0
  repeat
    i = i + 1
    if i > 0 then
      let w = i * 7
      fs[#fs + 1] = function() return w end
      if i < 3 then continue end
    end
  until i >= 3
  return fs
end)

run("for-repeat-nested", function()
  let fs = {}
  for i = 1, 2 do
    let n = 0
    repeat
      n = n + 1
      let c = i * 10 + n
      fs[#fs + 1] = function() return c end
      if n == 1 then continue end
    until n >= 2
  end
  return fs
end)

run("repeat-break", function()
  let fs = {}
  let i = 0
  repeat
    i = i + 1
    let v = -i
    fs[#fs + 1] = function() return v end
    if i == 2 then break end
  until false
  return fs
end)
