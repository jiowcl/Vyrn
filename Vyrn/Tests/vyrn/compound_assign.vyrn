-- 1.6.80: compound assignment *= /= //= %= ..= (+ -) on names and fields; target evaluated once.
def msg(ok, e, ...)
  if ok then return tostring(ok) .. ' ' .. tostring(e) end
  return 'err ' .. string.gsub(tostring(e), '^.-%d+: ', '')
end
let t = {x = 2, y = {z = 7}, s = "a"}
t.x *= 5
t["x"] /= 4
t.y.z //= 2
t.y["z"] %= 2
t.s ..= "bc"
let k = "x"
t[k] += 10
t[k] -= 0.5
print(t.x, t.y.z, t.s)
let a = {1, 2, 3}
let n = 0
def idx() n += 1 return 2 end
a[idx()] *= 7
print(a[2], n)
let m = -7
m %= 3
let q = -7
q //= 2
let f = 7.5
f //= 2
let s = "x"
s ..= 1
s ..= "y"
print(m, q, f, s)
G = 9
G /= 2
G %= 4
print(G)
def mk()
  let c = 3
  return function() c *= 2 return c end
end
let inc = mk()
inc()
print(inc())
let mat = {{1, 2}, {3, 4}}
mat[2][1] *= 10
print(mat[2][1])
print(msg(pcall(function() let z = 5 z //= 0 end)))
print(msg(pcall(function() let z = 5 z %= 0 end)))
print(msg(pcall(function() let z = {} z.v *= 2 end)))
print(msg(pcall(function() let z = 1 z ..= {} end)))
let w = 10
w *= 2 + 3
print(w, 7 // 2, 1 ~= 2, 1 != 2)
print(msg(pcall(function() let z = 1 return z .. {} end)))
print(msg(pcall(function() let z = "s" z *= 2 return z end)))
print(msg(pcall(function() let z = "a" z *= "b" return z end)))
def get() n += 1 return t end
get().x *= 2
get()["x"] //= 5
print(t.x, n)
let acc = ""
for i = 1, 3 do acc ..= i end
print(acc)
