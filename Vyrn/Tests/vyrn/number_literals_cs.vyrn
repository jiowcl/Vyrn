-- @compile-safe
-- vyrn: 12
-- 1.6.113: Lua 5.4 numerals: exponents, hex integers (wrapping to 64 bits), hex floats,
-- leading-dot decimals, '..' after a number, and tonumber / string coercion rules.
-- Numbers go through %.14g so Lua's integer/float subtypes print alike.
-- Expected output checked against Lua 5.4.

def show(...)
    let parts = {}
    for i = 1, select("#", ...) do
        let v = select(i, ...)
        if type(v) == "number" then
            parts[i] = string.format("%.14g", v)
        else
            parts[i] = tostring(v)
        end
    end
    print(table.concat(parts, " "))
end

show(0x10, 0xff, 0XA, 0x10p1, 0x1.8p1, 0xA.8p0, 0x.1p4, 0x1P-2)
show(.5, .25e1, 3e2, 1E-2, 1.5e+3, 2.e1, 7.)
show(0xffffffffffffffff, -0x1, 0x8000000000000000 == -9223372036854775807 - 1)
print(1 .. 2, 5 .. "", "a" .. 0x10, 2.5 .. "|" .. .5)
let t = {x = {y = 0x20}}
print(t.x.y, #"abc" .. 1)
show(tonumber("  0x1F  "), tonumber("-0x10"), tonumber("1e+2"), tonumber("0x1p4"))
show(tonumber(".5"), tonumber("5."), tonumber("\t42\n"), tonumber("+7"), tonumber("0x.8"))
show(tonumber("1e"), tonumber("0x"), tonumber("- 1"), tonumber("inf"), tonumber("nan"))
show(tonumber("1 2"), tonumber(""), tonumber("0x1g"), tonumber("1e5x"), tonumber("."))
show(tonumber("zz", 36), tonumber("8", 8), tonumber("-ff", 16), tonumber("777", 8), tonumber("1010", 2))
show(tonumber(" 11 ", 2), tonumber("-", 10), tonumber("", 10), tonumber("7fffffffffffffff", 16))
show("10" + 1, "0x10" + 0, "1e1" * 2, " 3 " - 1, "0x1p1" / 4)
print((pcall(function() return "abc" + 1 end)))
