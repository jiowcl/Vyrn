-- Showcase: json + zlib roundtrip (1.6.124). Stable output (no object key order).
let body = json.encode({10, 20, 30})
print("json", body)
let z = zlib.compress(body, {encoding = "hex"})
print("zlib_hex", z)
let back, err = zlib.decompress(z, {encoding = "hex"})
assert(back, err)
print("roundtrip", back)
let arr, derr = json.decode(back)
assert(arr, derr)
print("sum", arr[1] + arr[2] + arr[3])
print("adler", string.format("%08x", zlib.adler32(body)))

-- 1.6.129: file helpers (raw bytes on disk; interop via base64)
let dir = os.getenv("TEMP") or os.getenv("TMP") or os.getenv("TMPDIR") or path.cwd()
let src = path.join(dir, "_vyrn_zlib_show_src.bin")
let gz = path.join(dir, "_vyrn_zlib_show.gz")
let outp = path.join(dir, "_vyrn_zlib_show_out.bin")
os.remove(src)
os.remove(gz)
os.remove(outp)
assert(crypto.fromhex_file(src, "6869"))
assert(zlib.gzip_file(src, gz))
let back, ferr = zlib.gunzip(crypto.tobase64_file(gz))
assert(back == "hi", ferr)
assert(zlib.gunzip_file(gz, outp))
print("file_rt", crypto.tohex_file(outp))
os.remove(src)
os.remove(gz)
os.remove(outp)
print("done")
