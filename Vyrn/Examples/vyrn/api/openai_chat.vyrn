-- vyrn: 12
-- OpenAI Chat Completions client example (1.6.125; Doc / const / types in 1.6.147).
-- Reads OPENAI_API_KEY (required) and optional OPENAI_BASE_URL / OPENAI_MODEL.
-- Never hardcodes secrets. Needs --allow-net (or a host allowlist that includes the API host).
-- This file is not run against the real API in CI; see tests/vyrn/api_clients.vyrn.

const DEFAULT_BASE: string = "https://api.openai.com"
const DEFAULT_MODEL: string = "gpt-4o-mini"
const DEFAULT_PROMPT: string = "Say hello in one word."

@doc("Return the env value, or fallback when unset or empty")
def env_or(name: string, fallback: string) -> string
  let v = os.getenv(name) or ""
  if v == "" then
    return fallback
  end
  return v
end

let api = require("ai.openai")

let key = os.getenv("OPENAI_API_KEY") or ""
if key == "" then
  print("openai_chat: OPENAI_API_KEY is not set. Export a key (never commit it) and rerun with --allow-net.")
  os.exit(0)
end

let opts = {
  key = key,
  base = env_or("OPENAI_BASE_URL", DEFAULT_BASE),
  model = env_or("OPENAI_MODEL", DEFAULT_MODEL),
  prompt = DEFAULT_PROMPT,
  timeout = 30
}

let text, err = api.openai_chat(opts)
if not text then
  if api.is_disabled_net(err) then
    print("openai_chat: network access is disabled. Rerun with --allow-net (prefer --allow-net=api.openai.com).")
    os.exit(0)
  end
  print("openai_chat: " .. tostring(err))
  os.exit(1)
end
print(text)
