-- vyrn: 12
-- Adobe PDF Services Combine PDF example (Doc / const / types in 1.6.147).
-- Reads PDF_SERVICES_CLIENT_ID + PDF_SERVICES_CLIENT_SECRET (required).
-- Optional: PDF_SERVICES_BASE_URL, PDF1, PDF2, OUT_PDF.
-- Never hardcodes secrets. Needs --allow-net
--   (prefer --allow-net=pdf-services.adobe.io plus the S3 host that appears in uploadUri/downloadUri).
-- End-to-end against a real account when keys and two PDFs are present; CI uses a loopback mock instead.
-- Not run against the real API in CI.

const DEFAULT_BASE: string = "https://pdf-services.adobe.io"

let api = require("cloud.adobe_pdf")

@doc("Resolve a PDF path from an env var or a list of fallbacks")
def find_pdf(env_name: string, fallbacks: table)
  let envp = os.getenv(env_name) or ""
  if envp ~= "" then return envp end
  let i = 1
  while i <= #fallbacks do
    if path.isfile(fallbacks[i]) then return fallbacks[i] end
    i = i + 1
  end
  return nil
end

let client_id = os.getenv("PDF_SERVICES_CLIENT_ID") or ""
let client_secret = os.getenv("PDF_SERVICES_CLIENT_SECRET") or ""
if client_id == "" or client_secret == "" then
  print("adobe_combine_pdf: set PDF_SERVICES_CLIENT_ID and PDF_SERVICES_CLIENT_SECRET (never commit them) and rerun with --allow-net.")
  os.exit(0)
end

let base = os.getenv("PDF_SERVICES_BASE_URL") or DEFAULT_BASE
let pdf1 = find_pdf("PDF1", { "sample1.pdf", path.join("examples", "vyrn", "api", "sample1.pdf") })
let pdf2 = find_pdf("PDF2", { "sample2.pdf", path.join("examples", "vyrn", "api", "sample2.pdf") })
if not pdf1 or not pdf2 then
  print("adobe_combine_pdf: need two PDF files (set PDF1/PDF2 or place sample1.pdf + sample2.pdf).")
  os.exit(1)
end

let out_path = os.getenv("OUT_PDF") or "combine_output.pdf"

let token, err = api.adobe_get_token({
  client_id = client_id,
  client_secret = client_secret,
  base = base,
  timeout = 30
})
if not token then
  if api.is_disabled_net(err) then
    print("adobe_combine_pdf: network access is disabled. Rerun with --allow-net (prefer host allowlist).")
    os.exit(0)
  end
  print("adobe_combine_pdf: token: " .. tostring(err))
  os.exit(1)
end

let id1, e1 = api.adobe_upload_asset({
  token = token,
  client_id = client_id,
  base = base,
  path = pdf1,
  media_type = "application/pdf",
  timeout = 60
})
if not id1 then
  print("adobe_combine_pdf: upload1: " .. tostring(e1))
  os.exit(1)
end

let id2, e2 = api.adobe_upload_asset({
  token = token,
  client_id = client_id,
  base = base,
  path = pdf2,
  media_type = "application/pdf",
  timeout = 60
})
if not id2 then
  print("adobe_combine_pdf: upload2: " .. tostring(e2))
  os.exit(1)
end

let download_uri, combine_err = api.adobe_combine_pdf({
  token = token,
  client_id = client_id,
  base = base,
  asset_ids = { id1, id2 },
  timeout = 30,
  poll_interval = 2,
  poll_timeout = 120
})
if not download_uri then
  print("adobe_combine_pdf: combine: " .. tostring(combine_err))
  os.exit(1)
end

let saved, derr = api.adobe_download({
  url = download_uri,
  out_path = out_path,
  timeout = 60
})
if not saved then
  print("adobe_combine_pdf: download: " .. tostring(derr))
  os.exit(1)
end

print("merged PDF written to " .. saved)