-- vyrn: 12
-- Gemini File API-shaped upload example (1.6.127).
-- Uses a one-shot multipart POST (the official resumable protocol is not implemented).
-- Reads GEMINI_API_KEY (required) and optional GEMINI_BASE_URL / GEMINI_FILE.
-- Never hardcodes secrets. Needs --allow-net. Not run against the real API in CI;
-- see tests/vyrn/http_multipart.vyrn.

let api = require("clients")

def find_file()
  let envp = os.getenv("GEMINI_FILE") or ""
  if envp ~= "" then return envp end
  let cands = {
    "sample.png",
    path.join("examples", "vyrn", "api", "sample.png")
  }
  let i = 1
  while i <= #cands do
    if path.isfile(cands[i]) then return cands[i] end
    i = i + 1
  end
  return nil
end

let key = os.getenv("GEMINI_API_KEY") or ""
if key == "" then
  print("gemini_files: GEMINI_API_KEY is not set. Export a key (never commit it) and rerun with --allow-net.")
  os.exit(0)
end

let f = find_file()
if not f then
  print("gemini_files: sample.png not found (run from the repo root or examples/vyrn/api).")
  os.exit(1)
end

let data, err = api.gemini_files_upload({
  key = key,
  base = os.getenv("GEMINI_BASE_URL") or "https://generativelanguage.googleapis.com",
  path = f,
  content_type = "image/png",
  timeout = 30
})
if not data then
  if api.is_disabled_net(err) then
    print("gemini_files: network access is disabled. Rerun with --allow-net (prefer --allow-net=generativelanguage.googleapis.com).")
    os.exit(0)
  end
  print("gemini_files: " .. tostring(err))
  os.exit(1)
end
if type(data.file) == "table" then
  print(data.file.name, data.file.displayName, data.file.sizeBytes)
else
  print(json.encode(data))
end
