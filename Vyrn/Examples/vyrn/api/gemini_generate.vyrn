-- vyrn: 12
-- Gemini generateContent client example (1.6.125; Doc / const / types in 1.6.147).
-- Reads GEMINI_API_KEY (required) and optional GEMINI_BASE_URL / GEMINI_MODEL.
-- Never hardcodes secrets. Needs --allow-net (or a host allowlist that includes the API host).
-- This file is not run against the real API in CI; see tests/vyrn/api_clients.vyrn.

const DEFAULT_BASE: string = "https://generativelanguage.googleapis.com"
const DEFAULT_MODEL: string = "gemini-2.5-flash"
const DEFAULT_PROMPT: string = "Say hello in one word."

@doc("Return the env value, or fallback when unset or empty")
def env_or(name: string, fallback: string) -> string
  let v = os.getenv(name) or ""
  if v == "" then
    return fallback
  end
  return v
end

let api = require("ai.gemini")

let key = os.getenv("GEMINI_API_KEY") or ""
if key == "" then
  print("gemini_generate: GEMINI_API_KEY is not set. Export a key (never commit it) and rerun with --allow-net.")
  os.exit(0)
end

let opts = {
  key = key,
  base = env_or("GEMINI_BASE_URL", DEFAULT_BASE),
  model = env_or("GEMINI_MODEL", DEFAULT_MODEL),
  prompt = DEFAULT_PROMPT,
  timeout = 30
}

let text, err = api.gemini_generate(opts)
if not text then
  if api.is_disabled_net(err) then
    print("gemini_generate: network access is disabled. Rerun with --allow-net (prefer --allow-net=generativelanguage.googleapis.com).")
    os.exit(0)
  end
  print("gemini_generate: " .. tostring(err))
  os.exit(1)
end
print(text)
