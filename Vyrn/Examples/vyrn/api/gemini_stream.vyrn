-- vyrn: 12
-- Gemini streamGenerateContent SSE example (1.6.128; Doc / const / types in 1.6.147).
-- Uses opts.on_chunk + http.sse_events. Reads GEMINI_API_KEY (required) and
-- optional GEMINI_BASE_URL / GEMINI_MODEL / GEMINI_PROMPT.
-- Never hardcodes secrets. Needs --allow-net. Not run against the real API in CI;
-- see tests/vyrn/http_sse.vyrn.

const DEFAULT_BASE: string = "https://generativelanguage.googleapis.com"
const DEFAULT_MODEL: string = "gemini-2.5-flash"
const DEFAULT_PROMPT: string = "Say hello in one short sentence."

@doc("Return the env value, or fallback when unset or empty")
def env_or(name: string, fallback: string) -> string
  let v = os.getenv(name) or ""
  if v == "" then
    return fallback
  end
  return v
end

let api = require("ai.gemini")

let key = os.getenv("GEMINI_API_KEY") or ""
if key == "" then
  print("gemini_stream: GEMINI_API_KEY is not set. Export a key (never commit it) and rerun with --allow-net.")
  os.exit(0)
end

let model = env_or("GEMINI_MODEL", DEFAULT_MODEL)
let text, err = api.gemini_stream({
  key = key,
  base = env_or("GEMINI_BASE_URL", DEFAULT_BASE),
  model = model,
  prompt = env_or("GEMINI_PROMPT", DEFAULT_PROMPT)
})
if not text then
  print("gemini_stream: " .. tostring(err))
  os.exit(1)
end
print(text)
print("")
print("gemini_stream: done (" .. tostring(#text) .. " chars)")
