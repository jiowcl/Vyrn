-- vyrn: 12
-- Compatibility shim (1.6.136). Shared API clients now live under lib/.
-- 1.6.147: new examples should keep requiring lib/ modules directly (this shim stays for older scripts).
-- New code should require("ai.openai"), require("ai.gemini"), or require("cloud.adobe_pdf").
-- Used by tests/vyrn/api_clients.vyrn (loopback mock) and older scripts.

let net = require("net.util")
let openai = require("ai.openai")
let gemini = require("ai.gemini")
let adobe = require("cloud.adobe_pdf")

let M = {}
M.openai_chat = openai.openai_chat
M.openai_chat_tools = openai.openai_chat_tools
M.openai_embeddings = openai.openai_embeddings
M.gemini_generate = gemini.gemini_generate
M.gemini_generate_tools = gemini.gemini_generate_tools
M.gemini_embeddings = gemini.gemini_embeddings
M.openai_files_upload = openai.openai_files_upload
M.gemini_files_upload = gemini.gemini_files_upload
M.openai_chat_stream = openai.openai_chat_stream
M.gemini_stream = gemini.gemini_stream
M.is_disabled_net = net.is_disabled_net
M.adobe_get_token = adobe.adobe_get_token
M.adobe_upload_asset = adobe.adobe_upload_asset
M.adobe_combine_pdf = adobe.adobe_combine_pdf
M.adobe_download = adobe.adobe_download
-- 1.6.145: new thin wrappers (backward compatible additions)
M.adobe_submit_job = adobe.adobe_submit_job
M.adobe_poll_job = adobe.adobe_poll_job
M.adobe_run_job = adobe.adobe_run_job
M.adobe_run_asset_job = adobe.adobe_run_asset_job
M.adobe_create_pdf = adobe.adobe_create_pdf
M.adobe_html_to_pdf = adobe.adobe_html_to_pdf
M.adobe_export_pdf = adobe.adobe_export_pdf
M.adobe_pdf_to_images = adobe.adobe_pdf_to_images
M.adobe_ocr = adobe.adobe_ocr
M.adobe_compress_pdf = adobe.adobe_compress_pdf
M.adobe_linearize_pdf = adobe.adobe_linearize_pdf
M.adobe_protect_pdf = adobe.adobe_protect_pdf
M.adobe_remove_protection = adobe.adobe_remove_protection
M.adobe_split_pdf = adobe.adobe_split_pdf
M.adobe_extract_pdf = adobe.adobe_extract_pdf
M.adobe_pdf_properties = adobe.adobe_pdf_properties
return M
