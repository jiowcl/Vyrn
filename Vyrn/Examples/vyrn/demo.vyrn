-- Vyrn demo (typed surfaces; loop temps may stay bare)

let name: string = "Alice"
let age: number = 30
let is_programmer: boolean = true
let empty_var = nil
let list = {"apple", "banana", "cherry", false, 42}

def greet(name: string) -> string
    return "Hello, " .. name .. "!"
end

let def add(a: number, b: number) -> number
    return a + b
end

print(greet("Bob"))
print("Sum is:", add(10, 20))

for i = 1, 5 do
    print("Number: " .. i)
end

def greet_self(self) -> string
    return "Hi, I am " .. self.name
end

let person = { name = "Alice", age = 30, greet = greet_self }
print(person:greet())

print("floor(3.7)=", math.floor(3.7))
print("len('hello')=", string.len("hello"))

let n: number = 0
while n < 3 do
    print("while n=", n)
    n++
end

let m: number = 1
repeat
    print("repeat once more, m=", m)
    m = m + 1
until m >= 5
