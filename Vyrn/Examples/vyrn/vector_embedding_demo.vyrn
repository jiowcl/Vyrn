-- vyrn: 12
-- Simple offline embedding similarity demo
-- Demonstrates basic RAG concept using the current vector module

let v = require("vector")

-- Simulated document embeddings (in real use these would come from a model)
-- Using 5-dimensional vectors for readability; real embeddings are usually 384 / 768 / 1536 dim
let documents = {
  {
    id = 1,
    text = "Cats are cute pets that love sleeping and playing with yarn",
    embedding = { 0.92, 0.18, 0.05, 0.12, 0.08 }
  },
  {
    id = 2,
    text = "Dogs are humans' most loyal friends who enjoy walking and playing ball",
    embedding = { 0.85, 0.25, 0.10, 0.15, 0.12 }
  },
  {
    id = 3,
    text = "Cars are modern transportation vehicles that need fuel or charging",
    embedding = { 0.05, 0.08, 0.95, 0.10, 0.15 }
  },
  {
    id = 4,
    text = "Cats and dogs are both very popular household pets",
    embedding = { 0.88, 0.22, 0.07, 0.14, 0.10 }
  },
  {
    id = 5,
    text = "Airplanes can quickly transport people to distant places",
    embedding = { 0.10, 0.12, 0.20, 0.90, 0.18 }
  }
}

-- Simulated query embedding (e.g. "I want to find content about pets")
let query_embedding = { 0.90, 0.20, 0.06, 0.13, 0.09 }

print("=== Embedding Similarity Search Demo ===\n")

-- Calculate cosine similarity between the query and each document
let results = {}

for doc in documents do
  let score, err = v.cosine(query_embedding, doc.embedding)
  if score == nil then
    print("Error:", err)
  else
    results[#results + 1] = {
      id = doc.id,
      text = doc.text,
      score = score
    }
  end
end

-- Sort by similarity score (descending) - simple bubble sort
let n = #results
let i = 1
while i <= n do
  let j = 1
  while j <= n - i do
    if results[j].score < results[j + 1].score then
      let temp = results[j]
      results[j] = results[j + 1]
      results[j + 1] = temp
    end
    j = j + 1
  end
  i = i + 1
end

-- Print results
print("Similarity scores between query and documents (highest to lowest):\n")

for r in results do
  print(string.format("ID: %d | Score: %.4f", r.id, r.score))
  print("Content:", r.text)
  print("-----")
end

print("\nMost relevant document is ID:", results[1].id)
print("Content:", results[1].text)