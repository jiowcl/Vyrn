-- vyrn: 12
-- Gemini generateContent + file-upload helpers (extracted 1.6.136).
-- Doc comments and opts: table hints added in 1.6.145.
-- Load with require("ai.gemini"). Caller passes opts.key / opts.base.
-- Image: opts.image_path (crypto.tobase64_file) or opts.image_b64,
-- and optional opts.image_mime (default image/png).

let net = require("net.util")

@doc("generateContent helper (opts.key, optional opts.base / opts.model / opts.prompt / image)")
def gemini_generate(opts: table)
  if type(opts) ~= "table" then
    return nil, "gemini_generate: options table expected"
  end
  let key = opts.key or ""
  let base = opts.base or "https://generativelanguage.googleapis.com"
  let model = opts.model or "gemini-2.5-flash"
  let prompt = opts.prompt or "Say hello in one word."
  let timeout = opts.timeout or 30
  if key == "" then
    return nil, "missing API key"
  end
  let img, mime, ierr = net.resolve_image(opts)
  if ierr then
    return nil, ierr
  end
  let url = base .. "/v1beta/models/" .. model .. ":generateContent"
  let hdr = {}
  hdr["x-goog-api-key"] = key
  hdr["Content-Type"] = "application/json"
  let parts = { { text = prompt } }
  if img then
    parts[#parts + 1] = { inline_data = { mime_type = mime, data = img } }
  end
  let body = json.encode({
    contents = {
      { parts = parts }
    }
  })
  let r, err = http.request({ method = "POST", url = url, headers = hdr, body = body, timeout = timeout })
  if not r then
    return nil, err
  end
  if r.status < 200 or r.status >= 300 then
    return nil, "http " .. tostring(r.status) .. ": " .. tostring(r.body)
  end
  let data, jerr = json.decode(r.body)
  if not data then
    return nil, jerr
  end
  let cands = data.candidates
  if type(cands) ~= "table" or type(cands[1]) ~= "table" then
    return nil, "unexpected Gemini response"
  end
  let content = cands[1].content
  if type(content) ~= "table" or type(content.parts) ~= "table" or type(content.parts[1]) ~= "table" then
    return nil, "unexpected Gemini response"
  end
  return content.parts[1].text
end

@doc("generateContent with functionDeclarations; returns the model content table (parts may include functionCall)")
def gemini_generate_tools(opts: table)
  if type(opts) ~= "table" then
    return nil, "gemini_generate_tools: options table expected"
  end
  let key = opts.key or ""
  let base = opts.base or "https://generativelanguage.googleapis.com"
  let model = opts.model or "gemini-2.5-flash"
  let timeout = opts.timeout or 30
  let decls = opts.function_declarations
  if decls == nil then
    decls = opts.tools
  end
  if key == "" then
    return nil, "missing API key"
  end
  if type(decls) ~= "table" or #decls < 1 then
    return nil, "gemini_generate_tools: opts.function_declarations (or tools) array required"
  end
  let contents = opts.contents
  if type(contents) ~= "table" then
    let prompt = opts.prompt or "Say hello in one word."
    contents = { { parts = { { text = prompt } } } }
  end
  let url = base .. "/v1beta/models/" .. model .. ":generateContent"
  let hdr = {}
  hdr["x-goog-api-key"] = key
  hdr["Content-Type"] = "application/json"
  let body = json.encode({
    contents = contents,
    tools = {
      { functionDeclarations = decls }
    }
  })
  let r, err = http.request({ method = "POST", url = url, headers = hdr, body = body, timeout = timeout })
  if not r then
    return nil, err
  end
  if r.status < 200 or r.status >= 300 then
    return nil, "http " .. tostring(r.status) .. ": " .. tostring(r.body)
  end
  let data, jerr = json.decode(r.body)
  if not data then
    return nil, jerr
  end
  let cands = data.candidates
  if type(cands) ~= "table" or type(cands[1]) ~= "table" then
    return nil, "unexpected Gemini response"
  end
  let content = cands[1].content
  if type(content) ~= "table" then
    return nil, "unexpected Gemini response"
  end
  return content
end

@doc("POST /upload/v1beta/files multipart upload (opts.key, opts.path)")
def gemini_files_upload(opts: table)
  if type(opts) ~= "table" then
    return nil, "gemini_files_upload: options table expected"
  end
  let key = opts.key or ""
  let base = opts.base or "https://generativelanguage.googleapis.com"
  let file_path = opts.path or ""
  let timeout = opts.timeout or 30
  let filename = opts.filename
  let content_type = opts.content_type or "application/octet-stream"
  if key == "" then
    return nil, "missing API key"
  end
  if file_path == "" then
    return nil, "missing file path"
  end
  let hdr = {}
  hdr["x-goog-api-key"] = key
  let r, err = http.request({
    method = "POST",
    url = base .. "/upload/v1beta/files",
    headers = hdr,
    timeout = timeout,
    multipart = {
      {name = "file", path = file_path, filename = filename, content_type = content_type}
    }
  })
  if not r then
    return nil, err
  end
  if r.status < 200 or r.status >= 300 then
    return nil, "http " .. tostring(r.status) .. ": " .. tostring(r.body)
  end
  let data, jerr = json.decode(r.body)
  if not data then
    return nil, jerr
  end
  return data
end

@doc("streamGenerateContent SSE helper; optional opts.on_delta(piece)")
def gemini_stream(opts: table)
  if type(opts) ~= "table" then
    return nil, "gemini_stream: options table expected"
  end
  let key = opts.key or ""
  let base = opts.base or "https://generativelanguage.googleapis.com"
  let model = opts.model or "gemini-2.0-flash"
  let prompt = opts.prompt or "Say hello in one word."
  let timeout = opts.timeout or 60
  if key == "" then
    return nil, "missing API key"
  end
  let url = base .. "/v1beta/models/" .. model .. ":streamGenerateContent?alt=sse"
  let hdr = {}
  hdr["x-goog-api-key"] = key
  hdr["Content-Type"] = "application/json"
  let payload = {
    contents = {
      { role = "user", parts = { { text = prompt } } }
    }
  }
  let acc = ""
  let text = ""
  let r, err = http.request({
    method = "POST",
    url = url,
    headers = hdr,
    body = json.encode(payload),
    timeout = timeout,
    on_chunk = function(chunk)
      acc = acc .. chunk
      let evs, rest = http.sse_events(acc)
      acc = rest
      let i = 1
      while i <= #evs do
        if evs[i].data ~= "" then
          let obj, je = json.decode(evs[i].data)
          if obj and obj.candidates and obj.candidates[1] and obj.candidates[1].content then
            let parts = obj.candidates[1].content.parts
            if parts and parts[1] and parts[1].text then
              let piece = parts[1].text
              text = text .. piece
              if type(opts.on_delta) == "function" then
                opts.on_delta(piece)
              end
            end
          end
        end
        i = i + 1
      end
    end
  })
  if not r then
    return nil, err
  end
  if r.status < 200 or r.status >= 300 then
    return nil, "http " .. tostring(r.status)
  end
  return text
end

@doc("Embeddings helper; opts.input is a string or array of strings; returns one vector or an array of vectors")
def gemini_embeddings(opts: table)
  if type(opts) ~= "table" then
    return nil, "gemini_embeddings: options table expected"
  end
  let key = opts.key or ""
  let base = opts.base or "https://generativelanguage.googleapis.com"
  let model = opts.model or "text-embedding-004"
  let timeout = opts.timeout or 30
  let input = opts.input
  if key == "" then
    return nil, "missing API key"
  end
  if type(input) ~= "string" and type(input) ~= "table" then
    return nil, "gemini_embeddings: opts.input string or array required"
  end
  if type(input) == "table" and #input < 1 then
    return nil, "gemini_embeddings: opts.input array must be non-empty"
  end
  let hdr = {}
  hdr["x-goog-api-key"] = key
  hdr["Content-Type"] = "application/json"
  if type(input) == "string" then
    let url = base .. "/v1beta/models/" .. model .. ":embedContent"
    let body = json.encode({
      content = {
        parts = { { text = input } }
      }
    })
    let r, err = http.request({ method = "POST", url = url, headers = hdr, body = body, timeout = timeout })
    if not r then
      return nil, err
    end
    if r.status < 200 or r.status >= 300 then
      return nil, "http " .. tostring(r.status) .. ": " .. tostring(r.body)
    end
    let data, jerr = json.decode(r.body)
    if not data then
      return nil, jerr
    end
    let emb = data.embedding
    if type(emb) ~= "table" or type(emb.values) ~= "table" then
      return nil, "unexpected Gemini embeddings response"
    end
    return emb.values
  end
  let url = base .. "/v1beta/models/" .. model .. ":batchEmbedContents"
  let reqs = {}
  let i = 1
  while i <= #input do
    let t = input[i]
    if type(t) ~= "string" then
      return nil, "gemini_embeddings: opts.input array must contain strings"
    end
    reqs[i] = {
      model = "models/" .. model,
      content = {
        parts = { { text = t } }
      }
    }
    i = i + 1
  end
  let body = json.encode({ requests = reqs })
  let r, err = http.request({ method = "POST", url = url, headers = hdr, body = body, timeout = timeout })
  if not r then
    return nil, err
  end
  if r.status < 200 or r.status >= 300 then
    return nil, "http " .. tostring(r.status) .. ": " .. tostring(r.body)
  end
  let data, jerr = json.decode(r.body)
  if not data then
    return nil, jerr
  end
  let rows = data.embeddings
  if type(rows) ~= "table" or #rows < 1 then
    return nil, "unexpected Gemini embeddings response"
  end
  let out = {}
  let k = 1
  while k <= #rows do
    let vals = rows[k].values
    if type(vals) ~= "table" then
      return nil, "unexpected Gemini embeddings response"
    end
    out[k] = vals
    k = k + 1
  end
  return out
end

let M = {}
M.gemini_generate = gemini_generate
M.gemini_generate_tools = gemini_generate_tools
M.gemini_files_upload = gemini_files_upload
M.gemini_stream = gemini_stream
M.gemini_embeddings = gemini_embeddings
M.is_disabled_net = net.is_disabled_net
M.resolve_image = net.resolve_image
return M
